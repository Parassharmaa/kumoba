--- a/src/devices/src/virtio/vsock/unix.rs
+++ b/src/devices/src/virtio/vsock/unix.rs
@@ -752,3 +752,181 @@
         self.fd.as_raw_fd()
     }
 }
+
+#[cfg(all(test, target_os = "linux"))]
+mod close_regressions {
+    use super::*;
+    use crate::virtio::queue::{tests::VirtQueue, DescriptorChain};
+    use std::{io::Write, os::unix::net::UnixStream};
+    use utils::epoll::{ControlOperation, Epoll, EpollEvent};
+    use vm_memory::{Bytes, GuestAddress};
+
+    fn proxy(mem: &GuestMemoryMmap, vq: &VirtQueue<'_>, credit: u32) -> (UnixProxy, UnixStream) {
+        let (socket, peer) = UnixStream::pair().unwrap();
+        let mut proxy = UnixProxy::new_reverse(
+            1,
+            3,
+            4000,
+            5000,
+            socket.into(),
+            mem.clone(),
+            Arc::new(Mutex::new(vq.create_queue())),
+            Arc::new(Mutex::new(MuxerRxQ::new())),
+        );
+        proxy.status = ProxyStatus::Connected;
+        proxy.peer_buf_alloc = credit;
+        (proxy, peer)
+    }
+    fn buffers(vq: &VirtQueue<'_>, count: u16) {
+        for i in 0..16 {
+            vq.dtable[i].set(0x1000 + i as u64 * 0x1000, 44 + 16, 2, 0);
+            vq.avail.ring[i].set(i as u16);
+        }
+        vq.avail.idx.set(count);
+    }
+    fn closed_event(proxy: &UnixProxy, mut peer: UnixStream, bytes: &[u8]) -> EventSet {
+        let epoll = Epoll::new().unwrap();
+        epoll
+            .ctl(
+                ControlOperation::Add,
+                proxy.as_raw_fd(),
+                &EpollEvent::new(EventSet::IN, 1),
+            )
+            .unwrap();
+        peer.write_all(bytes).unwrap();
+        drop(peer);
+        let mut events = [EpollEvent::default()];
+        assert_eq!(epoll.wait(1, 1000, &mut events).unwrap(), 1);
+        let event = EventSet::from_bits(events[0].events).unwrap();
+        assert!(
+            event.contains(EventSet::IN | EventSet::HANG_UP),
+            "{event:?}"
+        );
+        eprintln!("observed readiness: {event:?}");
+        event
+    }
+    fn received(mem: &GuestMemoryMmap, vq: &VirtQueue<'_>) -> (Vec<u8>, Vec<u16>) {
+        let mut bytes = Vec::new();
+        let mut ops = Vec::new();
+        for i in 0..vq.used.idx.get() as usize {
+            let used = vq.used.ring[i].get();
+            let addr = 0x1000 + u64::from(used.id) * 0x1000;
+            let op: u16 = mem.read_obj(GuestAddress(addr + 30)).unwrap();
+            ops.push(op);
+            if op == uapi::VSOCK_OP_RW {
+                let len: u32 = mem.read_obj(GuestAddress(addr + 24)).unwrap();
+                let mut part = vec![0; len as usize];
+                mem.read_slice(&mut part, GuestAddress(addr + 44)).unwrap();
+                bytes.extend(part);
+            }
+        }
+        (bytes, ops)
+    }
+    fn credit(
+        proxy: &mut UnixProxy,
+        mem: &GuestMemoryMmap,
+        vq: &VirtQueue<'_>,
+        amount: u32,
+    ) -> ProxyUpdate {
+        let queue = vq.create_queue();
+        let head = DescriptorChain::checked_new(mem, queue.desc_table, 16, 15).unwrap();
+        let mut pkt = VsockPacket::from_rx_virtq_head(&head).unwrap();
+        pkt.set_buf_alloc(amount).set_fwd_cnt(0);
+        proxy.update_peer_credit(&pkt)
+    }
+    #[test]
+    fn final_bytes_precede_reset_on_combined_readable_hangup() {
+        let mem = GuestMemoryMmap::from_ranges(&[(GuestAddress(0), 0x20000)]).unwrap();
+        let vq = VirtQueue::new(GuestAddress(0), &mem, 16);
+        buffers(&vq, 16);
+        let (mut proxy, peer) = proxy(&mem, &vq, 1024);
+        let payload = b"response spread over several virtqueue buffers: final-byte!";
+        let ev = closed_event(&proxy, peer, payload);
+        let update = proxy.process_event(ev);
+        assert_eq!(received(&mem, &vq).0, payload);
+        assert_eq!(received(&mem, &vq).1.last(), Some(&uapi::VSOCK_OP_RST));
+        assert_eq!(proxy.status, ProxyStatus::Closed);
+        assert!(update.signal_queue);
+        assert!(matches!(update.remove_proxy, ProxyRemoval::Deferred));
+    }
+    #[test]
+    fn hangup_waits_for_credit_without_losing_tail() {
+        let mem = GuestMemoryMmap::from_ranges(&[(GuestAddress(0), 0x20000)]).unwrap();
+        let vq = VirtQueue::new(GuestAddress(0), &mem, 16);
+        buffers(&vq, 16);
+        let (mut proxy, peer) = proxy(&mem, &vq, 0);
+        let ev = closed_event(&proxy, peer, b"tail");
+        let update = proxy.process_event(ev);
+        assert_eq!(proxy.status, ProxyStatus::WaitingCreditUpdate);
+        assert!(update.polling.unwrap().2.is_empty());
+        assert!(update.push_credit_req.is_some());
+        assert!(received(&mem, &vq).1.is_empty());
+        let update = credit(&mut proxy, &mem, &vq, 0);
+        assert!(update.polling.is_none());
+        assert_eq!(proxy.status, ProxyStatus::WaitingCreditUpdate);
+        credit(&mut proxy, &mem, &vq, 1024);
+        proxy.process_event(ev);
+        assert_eq!(received(&mem, &vq).0, b"tail");
+        assert_eq!(proxy.status, ProxyStatus::Closed);
+    }
+    #[test]
+    fn hangup_waits_for_receive_buffers() {
+        let mem = GuestMemoryMmap::from_ranges(&[(GuestAddress(0), 0x20000)]).unwrap();
+        let vq = VirtQueue::new(GuestAddress(0), &mem, 16);
+        buffers(&vq, 0);
+        let (mut proxy, peer) = proxy(&mem, &vq, 1024);
+        let ev = closed_event(&proxy, peer, b"tail");
+        let update = proxy.process_event(ev);
+        assert_eq!(proxy.status, ProxyStatus::Connected);
+        assert!(update.polling.is_none());
+        assert!(update.push_credit_req.is_none());
+        vq.avail.idx.set(16);
+        proxy.process_event(ev);
+        assert_eq!(received(&mem, &vq).0, b"tail");
+        assert_eq!(proxy.status, ProxyStatus::Closed);
+    }
+    #[test]
+    fn empty_close_does_not_wait_for_credit() {
+        let mem = GuestMemoryMmap::from_ranges(&[(GuestAddress(0), 0x20000)]).unwrap();
+        let vq = VirtQueue::new(GuestAddress(0), &mem, 16);
+        buffers(&vq, 16);
+        let (mut proxy, peer) = proxy(&mem, &vq, 0);
+        let ev = closed_event(&proxy, peer, b"");
+        proxy.process_event(ev);
+        assert_eq!(proxy.status, ProxyStatus::Closed);
+        assert_eq!(received(&mem, &vq).1, vec![uapi::VSOCK_OP_RST]);
+    }
+    #[test]
+    fn partially_delivered_close_resumes_after_forwarded_credit() {
+        let mem = GuestMemoryMmap::from_ranges(&[(GuestAddress(0), 0x20000)]).unwrap();
+        let vq = VirtQueue::new(GuestAddress(0), &mem, 16);
+        buffers(&vq, 16);
+        let (mut proxy, peer) = proxy(&mem, &vq, 4);
+        let ev = closed_event(&proxy, peer, b"12345678");
+        proxy.process_event(ev);
+        assert_eq!(received(&mem, &vq).0, b"1234");
+        assert_eq!(proxy.status, ProxyStatus::WaitingCreditUpdate);
+        let queue = vq.create_queue();
+        let head = DescriptorChain::checked_new(&mem, queue.desc_table, 16, 15).unwrap();
+        let mut pkt = VsockPacket::from_rx_virtq_head(&head).unwrap();
+        pkt.set_buf_alloc(4).set_fwd_cnt(4);
+        proxy.update_peer_credit(&pkt);
+        proxy.process_event(ev);
+        assert_eq!(received(&mem, &vq).0, b"12345678");
+        assert_eq!(received(&mem, &vq).1.last(), Some(&uapi::VSOCK_OP_RST));
+        assert_eq!(proxy.status, ProxyStatus::Closed);
+    }
+    #[test]
+    fn write_half_close_keeps_existing_data_then_reset_semantics() {
+        let mem = GuestMemoryMmap::from_ranges(&[(GuestAddress(0), 0x20000)]).unwrap();
+        let vq = VirtQueue::new(GuestAddress(0), &mem, 16);
+        buffers(&vq, 16);
+        let (mut proxy, mut peer) = proxy(&mem, &vq, 1024);
+        peer.write_all(b"tail").unwrap();
+        peer.shutdown(std::net::Shutdown::Write).unwrap();
+        proxy.process_event(EventSet::IN);
+        assert_eq!(received(&mem, &vq).0, b"tail");
+        assert_eq!(received(&mem, &vq).1.last(), Some(&uapi::VSOCK_OP_RST));
+        assert_eq!(proxy.status, ProxyStatus::Closed);
+    }
+}
